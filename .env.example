# ============================================================
# Smart College Assistant - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Flask ---
FLASK_SECRET_KEY=your-very-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# --- IBM watsonx.ai ---
IBM_API_KEY=your-ibm-watsonx-api-key
IBM_PROJECT_ID=your-project-id
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_MODEL_ID=ibm/granite-13b-chat-v2

# --- Database ---
DATABASE_URL=sqlite:///database/college.db

# --- Vector Store ---
FAISS_INDEX_PATH=vectorstore/index

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Session ---
SESSION_TYPE=filesystem
SESSION_LIFETIME_MINUTES=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Security ---
WTF_CSRF_ENABLED=True
MAX_CONTENT_LENGTH=16777216
